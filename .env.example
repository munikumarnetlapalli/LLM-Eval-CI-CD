# =============================================================
# LLM Eval CI/CD — Environment Configuration Template
# Copy to .env and fill in your values. NEVER commit .env.
# =============================================================

# ─── LLM Provider (choose one) ───────────────────────────────
LLM_PROVIDER=mock                        # mock | openai | azure_openai | gemini

# OpenAI
OPENAI_API_KEY=sk-...

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# ─── Evaluation Target ───────────────────────────────────────
EVAL_TARGET=mock                         # mock | local_rag | http_rag | local_llm | http_model
EVAL_TARGET_URL=http://localhost:8080    # for http_rag / http_model

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://evaluser:evalpass@localhost:5432/llmeval
POSTGRES_USER=evaluser
POSTGRES_PASSWORD=evalpass
POSTGRES_DB=llmeval

# ─── Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=local                    # local | azure

# Azure Blob Storage (only needed if STORAGE_BACKEND=azure)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_CONTAINER=eval-results
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# ─── Azure Identity (for managed identity in prod) ───────────
AZURE_CLIENT_ID=your-client-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_SECRET=your-client-secret

# ─── Application Insights ────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ─── Evaluation Settings ─────────────────────────────────────
DEFAULT_DATASET_VERSION=v1
DEFAULT_DATASET_PATH=datasets/v1/golden.json
EVAL_TIMEOUT_SECONDS=60
EVAL_MAX_CONCURRENT=5

# ─── API Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-in-production

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
